{
  "name": "bgg-shop-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:report": "vitest run --reporter=json --outputFile=results/home-tests.json",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "generate:types": "openapi-typescript ../bgg-shop-bff/specs/openapi.yaml -o ./src/types/generated/bff-api.d.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "graphql": "^16.14.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
"devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.0",
    "msw": "^2.3.0",
    "openapi-typescript": "^7.0.0",
    "oxlint": "^0.15.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}
